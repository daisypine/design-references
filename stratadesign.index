<script>
  (function(){
    var section = document.querySelector('.shield-scroll');
    var strata = Array.prototype.slice.call(document.querySelectorAll('.stratum'));
    var items = Array.prototype.slice.call(document.querySelectorAll('.layer-item'));
    var outline = document.querySelector('.shield-outline');
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduce || window.innerWidth <= 820){
      strata.forEach(function(s){s.classList.add('on');});
      items.forEach(function(i){i.classList.add('on');});
      if(outline) outline.classList.add('on');
      return;
    }
    function setActive(count){
      strata.forEach(function(s){
        var o = parseInt(s.getAttribute('data-order'),10);
        s.classList.toggle('on', o <= count);
      });
      items.forEach(function(it){
        var o = parseInt(it.getAttribute('data-order'),10);
        it.classList.toggle('on', o <= count);
      });
      if(outline) outline.classList.toggle('on', count >= 4);
    }
    function onScroll(){
      var rect = section.getBoundingClientRect();
      var total = section.offsetHeight - window.innerHeight;
      var scrolled = Math.min(Math.max(-rect.top, 0), total);
      var progress = total > 0 ? scrolled / total : 0;
      var count = Math.min(4, Math.max(1, Math.ceil(progress * 4 + 0.35)));
      setActive(count);
    }
    setActive(1);
    window.addEventListener('scroll', onScroll, {passive:true});
    window.addEventListener('resize', onScroll);
    onScroll();
  })();
</script>
</body>
</html>
