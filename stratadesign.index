<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Strata Shield — Home Wireframe & Design Direction</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&family=Hanken+Grotesk:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#FBFAF7;
    --beige:#ECE5D6;
    --beige-deep:#E3DAC6;
    --ink:#16233C;
    --navy:#22406A;
    --navy-mid:#34618F;
    --navy-light:#5E8DBB;
    --gold:#C2A24C;
    --gold-deep:#9A7C2E;
    --slate:#4C5468;
    --line:#DAD2C0;
    --display:"Newsreader",Georgia,serif;
    --sans:"Hanken Grotesk",system-ui,sans-serif;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--sans);font-size:16px;line-height:1.6;-webkit-font-smoothing:antialiased;}
  h1,h2,h3{font-family:var(--display);font-weight:500;line-height:1.1;margin:0;letter-spacing:-0.01em;}
  p{margin:0;}
  .wrap{max-width:1080px;margin:0 auto;padding:0 40px;}
  .eyebrow{font-family:var(--sans);font-weight:600;font-size:12px;letter-spacing:0.14em;text-transform:uppercase;color:var(--gold-deep);}
  .btn{display:inline-block;font-family:var(--sans);font-weight:600;font-size:15px;padding:13px 22px;border-radius:4px;text-decoration:none;cursor:pointer;border:1.5px solid var(--ink);}
  .btn-primary{background:var(--ink);color:var(--paper);}
  .btn-ghost{background:transparent;color:var(--ink);}
  .muted{color:var(--slate);}

  /* ---------- designer brief banner ---------- */
  .brief{background:var(--ink);color:#D8E0EC;font-family:var(--sans);border-bottom:4px solid var(--gold);}
  .brief .wrap{padding-top:38px;padding-bottom:38px;}
  .brief h1{font-family:var(--display);color:#fff;font-size:30px;margin-bottom:6px;}
  .brief .sub{color:var(--gold);font-weight:600;font-size:13px;letter-spacing:0.12em;text-transform:uppercase;margin-bottom:22px;}
  .brief-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:22px 40px;margin-top:8px;}
  .brief-block h4{font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:0.1em;text-transform:uppercase;color:#8CA0BE;margin:0 0 8px;}
  .brief-block p,.brief-block li{font-size:14px;color:#CBD5E4;line-height:1.55;}
  .brief-block ul{margin:0;padding-left:18px;}
  .swatches{display:flex;gap:8px;flex-wrap:wrap;}
  .sw{width:100%;max-width:70px;}
  .sw .chip{height:34px;border-radius:4px;border:1px solid rgba(255,255,255,.18);}
  .sw span{font-size:10px;color:#9FB0C8;display:block;margin-top:4px;letter-spacing:.02em;}
  .brief-note{margin-top:22px;padding-top:18px;border-top:1px solid rgba(255,255,255,.14);font-size:13px;color:#9FB0C8;}
  .scroll-hint{text-align:center;padding:14px;font-family:var(--sans);font-size:13px;color:var(--slate);background:var(--beige);letter-spacing:.03em;}

  /* annotation tag on each section */
  .anno{position:relative;}
  .anno::before{content:attr(data-ref);position:absolute;top:10px;right:10px;font-family:var(--sans);font-size:10.5px;font-weight:600;letter-spacing:.06em;color:var(--gold-deep);background:rgba(255,255,255,.7);border:1px solid var(--line);padding:3px 8px;border-radius:20px;z-index:5;}

  /* ---------- site header ---------- */
  .site-head{background:var(--paper);border-bottom:1px solid var(--line);}
  .site-head .wrap{display:flex;align-items:center;justify-content:space-between;padding-top:20px;padding-bottom:20px;}
  .logo{display:flex;align-items:center;gap:10px;font-family:var(--display);font-size:20px;font-weight:600;color:var(--ink);}
  .logo .mark{width:22px;height:26px;}
  .nav{display:flex;align-items:center;gap:26px;font-size:15px;font-weight:500;}
  .nav a{color:var(--ink);text-decoration:none;}

  /* ---------- hero ---------- */
  .hero{background:var(--paper);}
  .hero .wrap{display:grid;grid-template-columns:1.05fr .95fr;gap:48px;align-items:center;padding-top:72px;padding-bottom:72px;}
  .hero h1{font-size:52px;margin-bottom:20px;}
  .hero h1 em{font-style:italic;color:var(--navy);}
  .hero p.lead{font-size:19px;color:var(--slate);margin-bottom:30px;max-width:34ch;}
  .hero .cta-row{display:flex;gap:12px;flex-wrap:wrap;}
  .ph{background:var(--beige);border:1px dashed var(--navy-light);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--navy);font-family:var(--sans);font-size:13px;font-weight:500;text-align:center;padding:12px;}
  .hero .ph{height:380px;}

  /* ---------- trusted-by ---------- */
  .trusted{background:var(--beige);border-top:1px solid var(--beige-deep);border-bottom:1px solid var(--beige-deep);}
  .trusted .wrap{padding-top:30px;padding-bottom:30px;}
  .trusted .cap{text-align:center;font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.12em;text-transform:uppercase;color:var(--slate);margin-bottom:20px;}
  .logo-row{display:grid;grid-template-columns:repeat(5,1fr);gap:16px;}
  .logo-slot{height:46px;border-radius:4px;background:rgba(255,255,255,.55);border:1px dashed var(--navy-light);display:flex;align-items:center;justify-content:center;color:var(--navy);font-size:12px;font-weight:500;}

  /* ---------- section base ---------- */
  section{padding:0;}
  .band{padding-top:76px;padding-bottom:76px;}
  .sec-head{max-width:620px;margin-bottom:40px;}
  .sec-head .eyebrow{display:block;margin-bottom:12px;}
  .sec-head h2{font-size:38px;margin-bottom:14px;}
  .sec-head p{font-size:17px;color:var(--slate);}

  /* difference cards */
  .diff{background:var(--paper);}
  .cards-3{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;}
  .card{background:#fff;border:1px solid var(--line);border-radius:10px;padding:26px 24px;}
  .card .ic{width:38px;height:38px;border-radius:8px;background:var(--beige);display:flex;align-items:center;justify-content:center;color:var(--navy);margin-bottom:16px;}
  .card h3{font-size:21px;margin-bottom:8px;}
  .card p{font-size:15px;color:var(--slate);}

  /* ---------- signature: layered shield scroll ---------- */
  .shield-scroll{background:var(--ink);position:relative;height:300vh;}
  .shield-sticky{position:sticky;top:0;height:100vh;display:flex;align-items:center;overflow:hidden;}
  .shield-sticky .wrap{display:grid;grid-template-columns:.85fr 1.15fr;gap:56px;align-items:center;width:100%;}
  .shield-copy .eyebrow{color:var(--gold);}
  .shield-copy h2{color:#fff;font-size:40px;margin:14px 0 18px;}
  .shield-copy .intro{color:#AEBED4;font-size:17px;margin-bottom:30px;max-width:36ch;}
  .layer-list{list-style:none;margin:0;padding:0;}
  .layer-item{padding:14px 0;border-top:1px solid rgba(255,255,255,.12);opacity:.32;transition:opacity .45s ease;}
  .layer-item:last-child{border-bottom:1px solid rgba(255,255,255,.12);}
  .layer-item.on{opacity:1;}
  .layer-item .lnum{font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.1em;color:var(--gold);}
  .layer-item h3{color:#fff;font-size:20px;margin:2px 0 3px;}
  .layer-item p{font-size:14px;color:#9FB0C8;}
  .shield-stage{display:flex;align-items:center;justify-content:center;}
  .shield-stage svg{width:330px;height:auto;}
  .stratum{opacity:0;transform:translateY(26px);transition:opacity .5s ease,transform .5s ease;transform-box:fill-box;transform-origin:center;}
  .stratum.on{opacity:1;transform:translateY(0);}
  .shield-outline{opacity:0;transition:opacity .6s ease .1s;}
  .shield-outline.on{opacity:1;}

  /* ---------- services ---------- */
  .services{background:var(--beige);}
  .cards-4{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;}
  .svc{background:#fff;border:1px solid var(--beige-deep);border-radius:10px;padding:22px;}
  .svc .ph{height:110px;margin-bottom:16px;background:var(--beige);}
  .svc h3{font-size:18px;margin-bottom:6px;}
  .svc p{font-size:14px;color:var(--slate);}

  /* ---------- process ---------- */
  .process{background:var(--paper);}
  .steps{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
  .step .snum{font-family:var(--display);font-size:15px;font-weight:600;color:var(--gold-deep);border-bottom:2px solid var(--gold);display:inline-block;padding-bottom:2px;margin-bottom:14px;}
  .step h3{font-size:22px;margin-bottom:8px;}
  .step p{font-size:15px;color:var(--slate);}

  /* ---------- testimonials ---------- */
  .quotes{background:var(--ink);}
  .quotes .sec-head h2{color:#fff;}
  .quotes .eyebrow{color:var(--gold);}
  .q-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:20px;}
  .quote{background:#1E3050;border:1px solid rgba(255,255,255,.1);border-radius:10px;padding:28px;}
  .quote p{font-family:var(--display);font-size:20px;line-height:1.4;color:#EAF0F8;margin-bottom:20px;}
  .quote .who{display:flex;align-items:center;gap:12px;}
  .quote .av{width:40px;height:40px;border-radius:50%;background:var(--gold);opacity:.85;}
  .quote .who small{color:#AEBED4;font-size:13px;display:block;}
  .quote .who b{color:#fff;font-weight:600;font-size:14px;}

  /* ---------- faq ---------- */
  .faq{background:var(--paper);}
  .faq-list{max-width:760px;}
  .faq-row{border-bottom:1px solid var(--line);padding:20px 0;display:flex;justify-content:space-between;align-items:center;gap:20px;}
  .faq-row:first-child{border-top:1px solid var(--line);}
  .faq-row h3{font-size:19px;font-weight:400;font-family:var(--display);color:var(--ink);}
  .faq-row .plus{color:var(--gold-deep);font-size:22px;font-weight:600;}

  /* ---------- lead capture ---------- */
  .lead{background:var(--beige);}
  .lead .wrap{display:grid;grid-template-columns:.9fr 1.1fr;gap:52px;align-items:start;}
  .lead h2{font-size:36px;margin-bottom:14px;}
  .lead p{color:var(--slate);font-size:17px;}
  .form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
  .field{height:48px;background:#fff;border:1px solid var(--beige-deep);border-radius:6px;display:flex;align-items:center;padding:0 14px;color:var(--slate);font-size:14px;}
  .field.full{grid-column:1 / -1;}
  .field.area{height:110px;align-items:flex-start;padding-top:14px;}
  .lead .btn{margin-top:16px;}

  /* ---------- footer ---------- */
  .foot{background:var(--ink);color:#AEBED4;}
  .foot .wrap{padding-top:52px;padding-bottom:28px;}
  .foot-grid{display:grid;grid-template-columns:1.4fr 1fr 1fr;gap:32px;margin-bottom:34px;}
  .foot .logo{color:#fff;margin-bottom:12px;}
  .foot h4{font-family:var(--sans);font-size:12px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:#8CA0BE;margin:0 0 12px;}
  .foot a,.foot p{color:#AEBED4;font-size:14px;text-decoration:none;display:block;margin-bottom:8px;}
  .foot .legal{border-top:1px solid rgba(255,255,255,.12);padding-top:20px;font-size:12.5px;color:#7E92AE;display:flex;justify-content:space-between;flex-wrap:wrap;gap:10px;}

  @media (max-width:820px){
    .wrap{padding:0 22px;}
    .hero .wrap,.lead .wrap,.shield-sticky .wrap{grid-template-columns:1fr;}
    .brief-grid,.cards-3,.cards-4,.q-grid,.steps,.form-grid,.foot-grid,.logo-row{grid-template-columns:1fr 1fr;}
    .hero h1{font-size:38px;}
    .shield-scroll{height:auto;}
    .shield-sticky{position:relative;height:auto;padding:60px 0;}
    .stratum,.shield-outline{opacity:1;transform:none;}
    .layer-item{opacity:1;}
  }
  @media (prefers-reduced-motion:reduce){
    html{scroll-behavior:auto;}
    .stratum,.shield-outline{opacity:1;transform:none;}
    .layer-item{opacity:1;}
  }
</style>
</head>
<body>

<!-- ============ DESIGNER BRIEF (not part of the site) ============ -->
<div class="brief">
  <div class="wrap">
    <div class="sub">For the designer · not a live page</div>
    <h1>Strata Shield — home page wireframe &amp; direction</h1>
    <p style="max-width:64ch;color:#CBD5E4;font-size:15px;">Mid-fidelity wireframe for the JD Van Nest → Strata Shield rebrand. Colors and type below are the direction; photos and final logo are still open. Layout and the layered-shield interaction are the parts to build to. Everything ships as a WordPress build (Elementor) after design.</p>

    <div class="brief-grid">
      <div class="brief-block">
        <h4>Concept</h4>
        <p><b style="color:#fff;">Layered protection.</b> Strata = layers, Shield = protection. Four services stack into one shield. This is the brand's whole idea — the signature scroll section makes it literal.</p>
      </div>
      <div class="brief-block">
        <h4>Palette — white &amp; beige base, navy + gold as the shield</h4>
        <div class="swatches">
          <div class="sw"><div class="chip" style="background:#FBFAF7;"></div><span>#FBFAF7 paper</span></div>
          <div class="sw"><div class="chip" style="background:#ECE5D6;"></div><span>#ECE5D6 beige</span></div>
          <div class="sw"><div class="chip" style="background:#16233C;"></div><span>#16233C navy</span></div>
          <div class="sw"><div class="chip" style="background:#34618F;"></div><span>#34618F mid</span></div>
          <div class="sw"><div class="chip" style="background:#C2A24C;"></div><span>#C2A24C gold</span></div>
        </div>
      </div>
      <div class="brief-block">
        <h4>Type</h4>
        <p><b style="color:#fff;">Newsreader</b> (serif display — warm, trustworthy) + <b style="color:#fff;">Hanken Grotesk</b> (sans body/UI). Both Google Fonts. Swap to brand fonts if the logo dictates.</p>
      </div>
      <div class="brief-block">
        <h4>Signature interaction — the layered shield</h4>
        <ul>
          <li>Section pins while the user scrolls.</li>
          <li>Shield builds from the base up, one layer per scroll step.</li>
          <li>Each layer = one service; its label lights up as it locks in.</li>
          <li>Gold outline binds the finished shield. Reduced-motion shows it whole.</li>
        </ul>
      </div>
      <div class="brief-block">
        <h4>Photography</h4>
        <p>Real people — client's own team/office shots preferred, or a local shoot. Stock is the fallback but reads generic (the thing Jonathan said he didn't want). Placeholders marked in dashed boxes.</p>
      </div>
      <div class="brief-block">
        <h4>References (what they liked)</h4>
        <ul>
          <li><b style="color:#fff;">Policygenius</b> — human feel, real people, home-page FAQ.</li>
          <li><b style="color:#fff;">KBI</b> — clean, one clear CTA, services grid.</li>
          <li><b style="color:#fff;">Bay Area Benefits</b> — simple, quote button to capture contact.</li>
        </ul>
      </div>
    </div>
    <p class="brief-note">Section tags (gold pills, top-right of each block) show which reference each section pulls from. Scroll down to walk the page.</p>
  </div>
</div>
<div class="scroll-hint">↓ home page wireframe begins</div>

<!-- ============ SITE HEADER ============ -->
<header class="site-head anno" data-ref="one clear CTA · KBI">
  <div class="wrap">
    <div class="logo">
      <svg class="mark" viewBox="0 0 22 26" fill="none"><path d="M11 1 L21 5 V13 C21 20 16 24 11 25 C6 24 1 20 1 13 V5 Z" fill="#16233C" stroke="#C2A24C" stroke-width="1.4"/><path d="M4 9 H18 M4 14 H18 M4 19 H18" stroke="#C2A24C" stroke-width="1" opacity=".7"/></svg>
      Strata Shield
    </div>
    <nav class="nav">
      <a href="#">Home</a><a href="#">Services</a><a href="#">About</a><a href="#">Contact</a>
      <a href="#" class="btn btn-primary" style="padding:10px 18px;">Schedule a call</a>
    </nav>
  </div>
</header>

<!-- ============ HERO ============ -->
<section class="hero anno" data-ref="human feel · Policygenius / KBI">
  <div class="wrap">
    <div>
      <h1>Employee benefits, built in <em>layers of protection</em>.</h1>
      <p class="lead">Strata Shield helps Bay Area employers design, manage, and protect benefits their teams actually value.</p>
      <div class="cta-row">
        <a href="#lead" class="btn btn-primary">Schedule a discovery call</a>
        <a href="#lead" class="btn btn-ghost">Request a quote</a>
      </div>
    </div>
    <div class="ph">real people photo — client team / office<br>(hero, ~1200×900)</div>
  </div>
</section>

<!-- ============ TRUSTED BY (new) ============ -->
<section class="trusted anno" data-ref="new · trust row (Policygenius)">
  <div class="wrap">
    <p class="cap">Carrier partners &amp; trusted by</p>
    <div class="logo-row">
      <div class="logo-slot">logo</div><div class="logo-slot">logo</div><div class="logo-slot">logo</div><div class="logo-slot">logo</div><div class="logo-slot">logo</div>
    </div>
    <p style="text-align:center;font-size:12px;color:var(--slate);margin-top:14px;">Carrier logos (Anthem, Blue Shield, Kaiser, etc.) or client logos — client to supply. Association marks (e.g. UBA) can sit here too.</p>
  </div>
</section>

<!-- ============ THE DIFFERENCE ============ -->
<section class="diff band anno" data-ref="why us · KBI / Bay Area">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">The Strata Shield difference</span>
      <h2>A real team behind every plan.</h2>
      <p>Not a call center, not a chatbot. The person you talk to is the person who handles your account.</p>
    </div>
    <div class="cards-3">
      <div class="card"><div class="ic">◆</div><h3>Personalized service</h3><p>One point of contact who knows your company, from renewal to day-to-day questions.</p></div>
      <div class="card"><div class="ic">◆</div><h3>Real people</h3><p>Licensed benefits advisors, not automated quotes. Human help when your team needs it.</p></div>
      <div class="card"><div class="ic">◆</div><h3>Layered protection</h3><p>Coverage, compliance, HR, and tech working together as one shield around your team.</p></div>
    </div>
  </div>
</section>

<!-- ============ SIGNATURE: LAYERED SHIELD SCROLL ============ -->
<section class="shield-scroll anno" data-ref="SIGNATURE · brand concept made literal" id="shield">
  <div class="shield-sticky">
    <div class="wrap">
      <div class="shield-copy">
        <span class="eyebrow">Layered protection</span>
        <h2>Four layers. One shield.</h2>
        <p class="intro">Scroll to see how each part of Strata Shield stacks into complete protection for your team.</p>
        <ul class="layer-list">
          <li class="layer-item" data-order="1"><span class="lnum">Layer 01</span><h3>Group health benefits</h3><p>The core — medical, dental, vision, and life.</p></li>
          <li class="layer-item" data-order="2"><span class="lnum">Layer 02</span><h3>Compliance</h3><p>ACA, ERISA, filings, and notices, handled and documented.</p></li>
          <li class="layer-item" data-order="3"><span class="lnum">Layer 03</span><h3>HR support</h3><p>A real team for your everyday people questions.</p></li>
          <li class="layer-item" data-order="4"><span class="lnum">Layer 04</span><h3>Enrollment technology</h3><p>Paperless onboarding your employees actually use.</p></li>
        </ul>
      </div>
      <div class="shield-stage">
        <svg viewBox="0 0 200 244" xmlns="http://www.w3.org/2000/svg" aria-label="Shield built from four service layers">
          <defs><clipPath id="shieldClip"><path d="M100 6 L190 40 V128 C190 186 150 224 100 238 C50 224 10 186 10 128 V40 Z"/></clipPath></defs>
          <g clip-path="url(#shieldClip)">
            <rect class="stratum" data-order="4" x="0" y="6"   width="200" height="60" fill="#5E8DBB"/>
            <rect class="stratum" data-order="3" x="0" y="64"  width="200" height="60" fill="#34618F"/>
            <rect class="stratum" data-order="2" x="0" y="122" width="200" height="60" fill="#22406A"/>
            <rect class="stratum" data-order="1" x="0" y="180" width="200" height="66" fill="#16233C"/>
            <line x1="0" y1="64"  x2="200" y2="64"  stroke="#C2A24C" stroke-width="1.2" opacity=".55"/>
            <line x1="0" y1="122" x2="200" y2="122" stroke="#C2A24C" stroke-width="1.2" opacity=".55"/>
            <line x1="0" y1="180" x2="200" y2="180" stroke="#C2A24C" stroke-width="1.2" opacity=".55"/>
          </g>
          <path class="shield-outline" d="M100 6 L190 40 V128 C190 186 150 224 100 238 C50 224 10 186 10 128 V40 Z" fill="none" stroke="#C2A24C" stroke-width="3.5"/>
        </svg>
      </div>
    </div>
  </div>
</section>

<!-- ============ SERVICES ============ -->
<section class="services band anno" data-ref="services grid · KBI / Bay Area">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">What we do</span>
      <h2>Everything your benefits program needs.</h2>
    </div>
    <div class="cards-4">
      <div class="svc"><div class="ph">icon / image</div><h3>Group health benefits</h3><p>Medical, dental, vision, life, and disability.</p></div>
      <div class="svc"><div class="ph">icon / image</div><h3>Compliance</h3><p>Filings, notices, and reporting, done right.</p></div>
      <div class="svc"><div class="ph">icon / image</div><h3>HR support</h3><p>Guidance and a real team on call.</p></div>
      <div class="svc"><div class="ph">icon / image</div><h3>Enrollment tech</h3><p>Paperless onboarding and self-service.</p></div>
    </div>
  </div>
</section>

<!-- ============ PROCESS ============ -->
<section class="process band anno" data-ref="process · Policygenius">
  <div class="wrap">
    <div class="sec-head">
      <span class="eyebrow">How it works</span>
      <h2>Simple to get started.</h2>
    </div>
    <div class="steps">
      <div class="step"><span class="snum">Step 01</span><h3>Discovery call</h3><p>We learn your team, your goals, and what's not working today.</p></div>
      <div class="step"><span class="snum">Step 02</span><h3>Custom strategy</h3><p>A benefits plan built around your budget and your people.</p></div>
